<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZeroTier.Views" 
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:NetworkModels="clr-namespace:ZeroTier.ViewModels.NetworkModels" 
             mc:Ignorable="av" 
             x:Class="ZeroTier.Views.NetworkSectionControl">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Networks owned" Grid.Row="0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       FontWeight="Bold" FontSize="20" Margin="10,0,0,0" />

            <local:NetworkListControl x:Name="NetworkListControl" Grid.Row="1" />
        </Grid>

        <local:NetworkEditionControl x:Name="NetworkEditionControl" Grid.Row="1" />
        
        <!--<Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Network edition"
                       Grid.Row="0" Grid.ColumnSpan="2"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       FontWeight="Bold" FontSize="20" Margin="10,0,0,0" />

            <Grid Name="NetworkEditionBasic" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="ID : " Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" Margin="10,0,0,0" 
                               TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock x:Name="NetworkId"  Grid.Row="0" Grid.Column="1"
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Margin="0" Width="120" Text="12ac4a1e71c49117" />

                    <TextBlock Text="Name :" Grid.Row="1" Grid.Column="0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                               Height="22" Margin="10,0,0,0" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBox x:Name="NetworkName" Grid.Row="1" Grid.Column="1"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                             Height="22" Margin="0,0,0,0" TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />

                    <TextBlock Text="Description :" Grid.Row="2" Grid.Column="0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                               Height="22" Margin="10,0,0,0" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBox x:Name="DescriptionTextBox" Grid.Row="2" Grid.Column="1"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                             Height="140" Margin="0,0,0,0" TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                </Grid>

                <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                        Height="30" Margin="5,0,10,0">
                    <Grid Name="NetworkAccessControl">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Access Control :" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="10,0,0,0" 
                                   TextWrapping="Wrap" FontWeight="Bold" />
                        <RadioButton x:Name="AccessControlPrivate" Content="Private" Grid.Column="1" 
                                     VerticalAlignment="Center" Margin="0,0,0,0" />
                        <RadioButton x:Name="AccessControlPublic" Content="Public" Grid.Column="2" 
                                     VerticalAlignment="Center" Margin="0,0,0,0" />
                    </Grid>
                </Border>

                <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="2"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                        Height="30" Margin="5,0,10,0">
                    <Grid Name="NetworkMulticast">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Multicast :" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="10,0,0,0" 
                                   TextWrapping="Wrap" FontWeight="Bold" />
                        <CheckBox x:Name="MulticastCheckBox" Content="Enable" Grid.Column="1"
                                   VerticalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="Recipient Limit :" Grid.Column="2"
                                   VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="RecipientLimitTextBox" Grid.Column="3"
                                 VerticalAlignment="Center" Width="60" Height="22" 
                                 Margin="0" TextWrapping="Wrap" BorderBrush="#FFA0A0A0" 
                                 IsEnabled="{Binding ElementName=MulticastCheckBox, Path=IsChecked}" />
                    </Grid>
                </Border>

                <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="3"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                        Height="120" Margin="5,0,10,0">
                    <Grid Name="NetworkDns">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DNS :" Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="10,0,0,0" 
                                   TextWrapping="Wrap" FontWeight="Bold" />
                        <TextBlock Text="Requires ZeroTier version 1.6. See Settings." Grid.Row="0" Grid.Column="1"
                                   VerticalAlignment="Center" Margin="0" 
                                   TextWrapping="Wrap" FontStyle="Italic" />
                        <TextBlock Text="Search domain" Grid.Row="1" Grid.Column="0" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="DnsDomainTextBox" Grid.Row="1" Grid.Column="1" 
                                 VerticalAlignment="Center" Width="250" Height="22" Margin="0" 
                                 TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                        <TextBlock Text="Server address" Grid.Row="2" Grid.Column="0" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="DnsServerTextBox" Grid.Row="2" Grid.Column="1" 
                                 VerticalAlignment="Center" Width="250" Height="22" Margin="0" 
                                 TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                    </Grid>
                </Border>

                <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="4"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                        Height="30" Margin="5,0,10,0">
                    <Grid Name="NetworkMembersStatus">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Members" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
                        <TextBlock Text="Online :" Grid.Column="1"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="NetworkOnlineMembers" Grid.Column="2"
                                   VerticalAlignment="Center" Margin="0" Text="06"/>
                        <TextBlock Text="Authorized :" Grid.Column="3"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="NetworkAuthorizedMembers" Grid.Column="4"
                                   VerticalAlignment="Center" Margin="0" Text="08"/>
                        <TextBlock Text="Total :" Grid.Column="5"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="NetworkTotalMembers" Grid.Column="6"
                                   VerticalAlignment="Center" Margin="0" Text="10"/>

                    </Grid>
                </Border>

                <Grid Name="NetworkTimes" Grid.Row="5" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Created :" Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
                    <TextBlock x:Name="NetworkCreatedTime" Grid.Row="0" Grid.Column="1"
                               VerticalAlignment="Center" Margin="10,0,0,0" Text="2024-10-24 15h42:52.000"/>

                    <TextBlock Text="Modified :" Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
                    <TextBlock x:Name="NetworkModifiedTime" Grid.Row="1" Grid.Column="1"
                               VerticalAlignment="Center" Margin="10,0,0,0" Text="2024-10-24 15h42:52.000"/>
                </Grid>

                <Button x:Name="SubmitEditedNetwork" Content="Submit basic changes" Grid.Row="6"
                        HorizontalAlignment="Center" VerticalAlignment="Top" 
                        Width="150" Height="28" Margin="0" />

            </Grid>

            <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.RowSpan="2" Grid.Column="1" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,10">
                <Grid Name="NetworkEditionAdvanced" Grid.RowSpan="2" Grid.Column="1" 
                      Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Advanced" Grid.Row="0"
                               HorizontalAlignment="Left" VerticalAlignment="Top" 
                               Margin="5,-15,0,0" FontWeight="Bold" TextDecorations="Underline" />

                    <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            Margin="5">
                        <Grid Name="NetworkRoutesGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="50" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Managed routes" Grid.Row="0" Grid.ColumnSpan="4"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                                       Margin="6,0,0,0" FontWeight="Bold" />
                            <TextBlock Text="LAN :" Grid.Row="1" Grid.Column="0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                                       Margin="10,0,0,0" FontWeight="Bold" />
                            <ListBox x:Name="NetworkRoutes" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                     Height="48" Margin="0">
                                <NetworkModels:RouteViewModel/>
                            </ListBox>
                            <Button Grid.Row="1" Grid.Column="3" 
                                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                                    Width="20" Height="20"
                                    Margin="10,0,0,0" BorderBrush="Snow">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Resources/delete-20.png"/>
                                </Button.Background>
                            </Button>

                            <TextBlock Text="Add routes :" Grid.Row="2" Grid.ColumnSpan="3"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                                       Margin="10,0,0,0" FontWeight="Bold" />
                            <TextBlock Text="Destination :" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                                       Margin="10,0,0,0" />
                            <TextBox x:Name="RouteDestination" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                     Height="22" Margin="0,0,10,0" 
                                     TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                            <TextBlock Text="Via :" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox x:Name="RouteVia" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                     Height="22" Margin="0,0,10,0" 
                                     TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="2"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                            Margin="5">
                        <StackPanel Name="IPv4AutoAssignStackPanel">
                            <TextBlock Text="IPv4 auto assign" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top" 
                                       Margin="5" FontWeight="Bold" />
                            <CheckBox x:Name="IPv4AutoAssign" Content="Auto-assign from range" 
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5" 
                                      Checked="IPv4AutoAssign_Checked" Unchecked="IPv4AutoAssign_Unchecked" />
                            
                            <Grid x:Name="IPv4AutoAssignGrid" HorizontalAlignment="Stretch" 
                                  VerticalAlignment="Stretch" IsEnabled="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="IPv4 avaliable" Grid.Row="0" 
                                           HorizontalAlignment="Left" VerticalAlignment="Top" 
                                           Margin="5,2" FontWeight="Bold" />

                                <TextBlock Text="10.147.17.*" Grid.Row="1" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.147.18.*" Grid.Row="1" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.147.19.*" Grid.Row="1" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.147.20.*" Grid.Row="1" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.144.*.*" Grid.Row="2" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.241.*.*" Grid.Row="2" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.242.*.*" Grid.Row="2" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.243.*.*" Grid.Row="2" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="10.244.*.*" Grid.Row="3" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.22.*.*" Grid.Row="3" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.23.*.*" Grid.Row="3" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.24.*.*" Grid.Row="3" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.25.*.*" Grid.Row="4" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.26.*.*" Grid.Row="4" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.27.*.*" Grid.Row="4" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.28.*.*" Grid.Row="4" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.29.*.*" Grid.Row="5" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="172.30.*.*" Grid.Row="5" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.191.*" Grid.Row="5" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.192.*" Grid.Row="5" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.193.*" Grid.Row="6" Grid.Column="0" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.194.*" Grid.Row="6" Grid.Column="1" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.195.*" Grid.Row="6" Grid.Column="2" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                                <TextBlock Text="192.168.196.*" Grid.Row="6" Grid.Column="3" Margin="2" 
                                           Style="{StaticResource SelectableTextBlockStyle}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#FFD4D4D4" BorderThickness="1" Grid.Row="3"
                            VerticalAlignment="Top" Margin="5">
                        <Grid Name="IPv6AutoAssign">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="IPv6 auto assign" Grid.Row="0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" 
                                       Margin="4" FontWeight="Bold" />

                            <CheckBox x:Name="IPv6RFC4193CheckBox" Content="ZeroTier RFC4193 (/128 for each device)" 
                                      Checked="CheckBox_Checked" Grid.Row="1"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
                            <TextBlock x:Name="IPv6RFC4193" Text="fd12:ac4a:1e71:c491:1799:93__:____:____" Grid.Row="2"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" 
                                       Width="270" Height="22" Margin="40,4,0,0" 
                                       Visibility="{Binding IsChecked, ElementName=IPv6RFC4193CheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <CheckBox x:Name="IPv66PLANECheckBox" Content="ZeroTier 6PLANE (/80 routable for each device)" 
                                      Checked="CheckBox_Checked" Grid.Row="3"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
                            <TextBlock x:Name="IPv66PLANE" Text="fc63:68db:09__:____:____:0000:0000:0001" Grid.Row="4"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" 
                                       Width="270" Height="22" Margin="40,4,0,0" 
                                       Visibility="{Binding IsChecked, ElementName=IPv66PLANECheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <CheckBox x:Name="IPv6utoAssignCheckBox" Content="Auto-Assign from Range" 
                                      Checked="CheckBox_Checked" Grid.Row="5"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,6" />
                            <Grid x:Name="Ipv6AutoRangeGrid" Grid.Row="6"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" 
                                  Width="350" Height="52" Margin="40,4,0,6" 
                                  Visibility="{Binding IsChecked, ElementName=IPv6utoAssignCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Range start" 
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" />
                                <TextBox x:Name="IPv6RangeStart" 
                                         HorizontalAlignment="Left" VerticalAlignment="Top" 
                                         Width="270" Height="22" Margin="80,0,0,0" 
                                         TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                                <TextBlock Text="Range end" 
                                           HorizontalAlignment="Left" VerticalAlignment="Top" 
                                           Margin="0,30,0,0" />
                                <TextBox x:Name="IPv6RangeEnd" 
                                         HorizontalAlignment="Left" VerticalAlignment="Top" 
                                         Width="270" Height="22" Margin="80,30,0,0" 
                                         TextWrapping="Wrap" BorderBrush="#FFA0A0A0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button x:Name="SubmitAdvancedNetwork" Content="Submit advanced changes" Grid.Row="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" 
                                    Width="180" Height="28" Margin="0" />
                </Grid>
            </Border>

            <Button x:Name="SubmitUpdatedNetwork" Content="Submit all updates" 
                    Grid.Row="2" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Top" 
                    Width="140" Height="28" />

        </Grid>-->
    </Grid>
</UserControl>
